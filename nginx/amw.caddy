# chat.amwairconditioning.com -- AMW chatbot API (Claude-powered)
# This is a REFERENCE COPY. The live file is /etc/caddy/sites/chat-amwairconditioning.caddy
# on the advance1 host (40.160.29.159) -- edit there, not here, then copy back.
# Provisioned 2026-08-01. VM: amw-chatbot (10.10.10.229), port 5001.

(amw_chatbot_common) {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}

chat.amwairconditioning.com {
    import amw_chatbot_common
    reverse_proxy 10.10.10.229:5001 {
        header_up X-Forwarded-Proto https
    }
}
