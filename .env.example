# AMW Cooling & Heating — Frontend Environment Variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Not required for production — chatbot runs through backend proxy
# PORT=3000

# Self-hosted Supabase/PostgREST instance for the booking widget (see
# booking-api/db/supabase-schema.sql for the schema this expects). Baked
# in at build time since this site is a static export -- set both in
# Vercel's project env vars, not just locally. NEXT_PUBLIC_SUPABASE_ANON_KEY
# is safe to expose client-side by design (RLS + SECURITY DEFINER RPC
# functions gate everything it can actually do) -- never put the
# service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://booking.amwairconditioning.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# EmailJS sends the booking confirmation (to the customer) and notification
# (to admin@amwairconditioning.com) emails straight from the browser -- there's
# no server to hold a secret mail API key on a static export. Create a free
# EmailJS account (emailjs.com), connect a sending mailbox as a Service, and
# create two Templates (see src/lib/bookingEmail.js for the exact variable
# names each template should reference). All four values below are safe to
# expose client-side by design. If left blank, booking emails are skipped
# silently (booking still succeeds -- see console for a warning).
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_CUSTOMER_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_ADMIN_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
