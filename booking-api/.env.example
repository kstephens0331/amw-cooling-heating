# Copy to .env on the server (never commit the real .env).

# A strong random password for the booking-only Postgres database.
# Generate one with: openssl rand -base64 24
POSTGRES_PASSWORD=

# Resend API key (resend.com) used to send booking confirmation and admin
# notification emails. stephenscode.dev already has Resend's DNS records
# configured, so this only needs an API key, not new DNS setup.
RESEND_API_KEY=

# Must be an address on a domain verified in Resend.
BOOKING_FROM_EMAIL="AMW Cooling & Heating <bookings@stephenscode.dev>"

# Where new-booking notifications go. This was the whole point of the fix --
# make sure it's the real, monitored address, not a stale one.
BOOKING_ADMIN_EMAIL=admin@amwairconditioning.com

# The live AMW site's origin(s) -- comma-separated, no trailing slash.
# The API rejects browser requests from any other origin.
ALLOWED_ORIGINS=https://amwairconditioning.com,https://www.amwairconditioning.com

# Used to build the cancellation link sent in confirmation emails.
PUBLIC_SITE_URL=https://amwairconditioning.com

BUSINESS_TIMEZONE=America/Chicago
PORT=4000
